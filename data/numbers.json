  "rules": [
    { "id": "eleven_to_ninety_nine",
      "question": "How are the numbers from 11 to 99 built?",
      "answer": "The unit comes first, then the ten, joined by ordinary sandhi. A few units change shape: ekā- in 11 only, dvā- in 12/22/32, trayas- in 13/23/33, aṣṭā- in 18/28/38, and ṣo- in 16.",
      "examples": [
        { "value": 25, "iast": "pañcaviṃśatiḥ", "devanagari": "पञ्चविंशतिः" },
        { "value": 14, "iast": "caturdaśa", "devanagari": "चतुर्दश" }
      ] },
    { "id": "una",
      "question": "What does ūna- or ekona- mean at the start of a number?",
      "answer": "\"Less one\" (ekona = eka + ūna): any 9 can be said as the next ten less one.",
      "examples": [
        { "value": 19, "iast": "ekonaviṃśatiḥ", "devanagari": "एकोनविंशतिः" },
        { "value": 99, "iast": "ekonaśatam", "devanagari": "एकोनशतम्" }
      ] },
    { "id": "above_hundred",
      "question": "How are numbers just above 100 or 1000 said?",
      "answer": "The extra amount + uttara or adhika (\"exceeded by\") + the hundred or thousand.",
      "examples": [
        { "value": 108, "iast": "aṣṭottaraśatam", "devanagari": "अष्टोत्तरशतम्" },
        { "value": 105, "iast": "pañcādhikaṃ śatam", "devanagari": "पञ्चाधिकं शतम्" }
      ] }
  ]
}
